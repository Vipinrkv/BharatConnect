# Environment Settings
ENVIRONMENT=development
DEBUG=True

# Database Configuration (Supabase PostgreSQL Connection)
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@your-supabase-db-host.supabase.co:5432/postgres

# Redis Cache and WebSocket Broker Configuration
REDIS_URL=redis://your-redis-host:6379/0

# Supabase Auth Integration
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_key_here

# Firebase Admin SDK Credentials (JSON encoded or reference path)
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "bharatconnect", ...}
